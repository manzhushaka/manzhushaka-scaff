<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.manzhushaka.iip.mapper.IipActivityMapper">
    
    <resultMap type="IipActivity" id="IipActivityResult">
    	<id     property="activityId"    column="activity_id"    />
        <result property="activityNo"    column="activity_no"    />
        <result property="activityName"  column="activity_name"  />
        <result property="coverImage"    column="cover_image"    />
        <result property="description"   column="description"    />
        <result property="startTime"     column="start_time"     />
        <result property="endTime"       column="end_time"       />
        <result property="pointsRatio"   column="points_ratio"   />
        <result property="merchantLimit" column="merchant_limit" />
        <result property="couponQuota"   column="coupon_quota"   />
        <result property="city"          column="city"           />
        <result property="regionType"    column="region_type"    />
        <result property="regionName"    column="region_name"    />
        <result property="priority"      column="priority"       />
        <result property="status"        column="status"         />
        <result property="createBy"      column="create_by"      />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"      column="update_by"      />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"        column="remark"         />
    </resultMap>
    
    <sql id="selectIipActivityVo">
        select activity_id, activity_no, activity_name, cover_image, description, start_time, end_time, points_ratio, merchant_limit, coupon_quota, city, region_type, region_name, priority, status, create_by, create_time, update_by, update_time, remark 
		from iip_activity
    </sql>
    
    <select id="selectIipActivityList" parameterType="IipActivity" resultMap="IipActivityResult">
        <include refid="selectIipActivityVo"/>
        <where>
			<if test="activityNo != null and activityNo != ''">
				AND activity_no = #{activityNo}
			</if>
			<if test="activityName != null and activityName != ''">
				AND activity_name like concat('%', #{activityName}, '%')
			</if>
			<if test="status != null and status != ''">
				AND status = #{status}
			</if>
			<if test="params.beginTime != null and params.beginTime != ''"><!-- 开始时间检索 -->
				and date_format(start_time,'%Y%m%d') &gt;= date_format(#{params.beginTime},'%Y%m%d')
			</if>
			<if test="params.endTime != null and params.endTime != ''"><!-- 结束时间检索 -->
				and date_format(end_time,'%Y%m%d') &lt;= date_format(#{params.endTime},'%Y%m%d')
			</if>
		</where>
		order by activity_id desc
    </select>
    
    <select id="selectIipActivityById" parameterType="Long" resultMap="IipActivityResult">
        <include refid="selectIipActivityVo"/>
        where activity_id = #{activityId}
    </select>
    
    <!-- 当前生效活动：启用且在时间窗内，取优先级最高的一个 -->
    <select id="selectCurrentActivity" resultMap="IipActivityResult">
        <include refid="selectIipActivityVo"/>
        where status = '0'
          and start_time &lt;= #{now}
          and end_time &gt;= #{now}
        order by priority desc, start_time desc
        limit 1
    </select>

    <!-- 全部生效活动：启用且在时间窗内，按优先级倒序、开始时间倒序 -->
    <select id="selectActiveActivities" resultMap="IipActivityResult">
        <include refid="selectIipActivityVo"/>
        where status = '0'
          and start_time &lt;= #{now}
          and end_time &gt;= #{now}
        order by priority desc, start_time desc
    </select>

    <!-- 查询指定编号前缀下最大的活动编号 -->
    <select id="selectMaxActivityNo" resultType="String">
        select activity_no from iip_activity
        where activity_no like concat(#{prefix}, '%')
        order by activity_no desc
        limit 1
    </select>

    <!-- 统计指定活动编号的出现次数（查重） -->
    <select id="countByActivityNo" parameterType="String" resultType="int">
        select count(*) from iip_activity where activity_no = #{activityNo}
    </select>

    <insert id="insertIipActivity" parameterType="IipActivity" useGeneratedKeys="true" keyProperty="activityId">
        insert into iip_activity (
			<if test="activityNo != null and activityNo != '' ">activity_no,</if>
			<if test="activityName != null and activityName != '' ">activity_name,</if>
			<if test="coverImage != null and coverImage != '' ">cover_image,</if>
			<if test="description != null and description != '' ">description,</if>
			<if test="startTime != null">start_time,</if>
			<if test="endTime != null">end_time,</if>
			<if test="pointsRatio != null">points_ratio,</if>
			<if test="merchantLimit != null">merchant_limit,</if>
			<if test="couponQuota != null">coupon_quota,</if>
			<if test="city != null and city != '' ">city,</if>
			<if test="regionType != null and regionType != '' ">region_type,</if>
			<if test="regionName != null and regionName != '' ">region_name,</if>
			<if test="priority != null">priority,</if>
			<if test="status != null and status != '' ">status,</if>
			<if test="createBy != null and createBy != ''">create_by,</if>
			<if test="remark != null and remark != ''">remark,</if>
 			create_time
        )values(
			<if test="activityNo != null and activityNo != ''">#{activityNo},</if>
			<if test="activityName != null and activityName != ''">#{activityName},</if>
			<if test="coverImage != null and coverImage != ''">#{coverImage},</if>
			<if test="description != null and description != ''">#{description},</if>
			<if test="startTime != null">#{startTime},</if>
			<if test="endTime != null">#{endTime},</if>
			<if test="pointsRatio != null">#{pointsRatio},</if>
			<if test="merchantLimit != null">#{merchantLimit},</if>
			<if test="couponQuota != null">#{couponQuota},</if>
			<if test="city != null and city != ''">#{city},</if>
			<if test="regionType != null and regionType != ''">#{regionType},</if>
			<if test="regionName != null and regionName != ''">#{regionName},</if>
			<if test="priority != null">#{priority},</if>
			<if test="status != null and status != ''">#{status},</if>
			<if test="createBy != null and createBy != ''">#{createBy},</if>
			<if test="remark != null and remark != ''">#{remark},</if>
 			sysdate()
		)
    </insert>
	 
    <update id="updateIipActivity" parameterType="IipActivity">
        update iip_activity 
        <set>
            <if test="activityNo != null and activityNo != ''">activity_no = #{activityNo},</if>
            <if test="activityName != null and activityName != ''">activity_name = #{activityName},</if>
            <if test="coverImage != null">cover_image = #{coverImage},</if>
            <if test="description != null">description = #{description},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="pointsRatio != null">points_ratio = #{pointsRatio},</if>
            <if test="merchantLimit != null">merchant_limit = #{merchantLimit},</if>
            <if test="couponQuota != null">coupon_quota = #{couponQuota},</if>
            <if test="city != null">city = #{city},</if>
            <if test="regionType != null and regionType != ''">region_type = #{regionType},</if>
            <if test="regionName != null">region_name = #{regionName},</if>
            <if test="priority != null">priority = #{priority},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
 			update_time = sysdate()
        </set>
        where activity_id = #{activityId}
    </update>
	
    <delete id="deleteIipActivityById" parameterType="Long">
        delete from iip_activity where activity_id = #{activityId}
    </delete>
    
    <delete id="deleteIipActivityByIds" parameterType="Long">
        delete from iip_activity where activity_id in 
        <foreach item="activityId" collection="array" open="(" separator="," close=")">
        	#{activityId}
        </foreach>
    </delete>
    
</mapper>
