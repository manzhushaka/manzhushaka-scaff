<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.manzhushaka.iip.mapper.IipActivityMerchantMapper">
    
    <resultMap type="IipActivityMerchant" id="IipActivityMerchantResult">
    	<id     property="id"          column="id"          />
        <result property="activityId"  column="activity_id" />
        <result property="merchantId"  column="merchant_id" />
        <result property="status"      column="status"      />
        <result property="createBy"    column="create_by"   />
        <result property="createTime"  column="create_time" />
        <result property="updateBy"    column="update_by"   />
        <result property="updateTime"  column="update_time" />
        <result property="remark"      column="remark"      />
    </resultMap>
    
    <sql id="selectIipActivityMerchantVo">
        select id, activity_id, merchant_id, status, create_by, create_time, update_by, update_time, remark 
		from iip_activity_merchant
    </sql>
    
    <select id="selectIipActivityMerchantList" parameterType="IipActivityMerchant" resultMap="IipActivityMerchantResult">
        <include refid="selectIipActivityMerchantVo"/>
        <where>
			<if test="activityId != null">
				AND activity_id = #{activityId}
			</if>
			<if test="merchantId != null">
				AND merchant_id = #{merchantId}
			</if>
			<if test="status != null and status != ''">
				AND status = #{status}
			</if>
		</where>
    </select>
    
    <select id="selectIipActivityMerchantById" parameterType="Long" resultMap="IipActivityMerchantResult">
        <include refid="selectIipActivityMerchantVo"/>
        where id = #{id}
    </select>
    
    <select id="selectByActivityId" parameterType="Long" resultMap="IipActivityMerchantResult">
        <include refid="selectIipActivityMerchantVo"/>
        where activity_id = #{activityId}
    </select>

    <resultMap type="IipActivityMerchant" id="IipActivityMerchantJoinResult" extends="IipActivityMerchantResult">
        <result property="merchantNo"     column="merchant_no"     />
        <result property="merchantName"   column="merchant_name"   />
        <result property="category"       column="category"        />
        <result property="merchantStatus" column="merchant_status" />
    </resultMap>

    <!-- 按活动ID查询参与商户关联列表（join iip_merchant 携带商户编号/名称/类别/状态） -->
    <select id="selectMerchantJoinList" parameterType="Long" resultMap="IipActivityMerchantJoinResult">
        select am.id, am.activity_id, am.merchant_id, am.status, am.create_by, am.create_time, am.update_by, am.update_time, am.remark,
               m.merchant_no, m.merchant_name, m.category, m.status as merchant_status
        from iip_activity_merchant am
        left join iip_merchant m on m.merchant_id = am.merchant_id
        where am.activity_id = #{activityId}
        order by am.id asc
    </select>

    <!-- 统计活动已配置商户数量 -->
    <select id="countByActivityId" parameterType="Long" resultType="int">
        select count(*) from iip_activity_merchant where activity_id = #{activityId}
    </select>

    <insert id="insertIipActivityMerchant" parameterType="IipActivityMerchant" useGeneratedKeys="true" keyProperty="id">
        insert into iip_activity_merchant (
			<if test="activityId != null">activity_id,</if>
			<if test="merchantId != null">merchant_id,</if>
			<if test="status != null and status != '' ">status,</if>
			<if test="createBy != null and createBy != ''">create_by,</if>
			<if test="remark != null and remark != ''">remark,</if>
 			create_time
        )values(
			<if test="activityId != null">#{activityId},</if>
			<if test="merchantId != null">#{merchantId},</if>
			<if test="status != null and status != ''">#{status},</if>
			<if test="createBy != null and createBy != ''">#{createBy},</if>
			<if test="remark != null and remark != ''">#{remark},</if>
 			sysdate()
		)
    </insert>
	 
    <update id="updateIipActivityMerchant" parameterType="IipActivityMerchant">
        update iip_activity_merchant 
        <set>
            <if test="activityId != null">activity_id = #{activityId},</if>
            <if test="merchantId != null">merchant_id = #{merchantId},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
 			update_time = sysdate()
        </set>
        where id = #{id}
    </update>
	
    <delete id="deleteIipActivityMerchantById" parameterType="Long">
        delete from iip_activity_merchant where id = #{id}
    </delete>

    <delete id="deleteByActivityId" parameterType="Long">
        delete from iip_activity_merchant where activity_id = #{activityId}
    </delete>
    
    <delete id="deleteIipActivityMerchantByIds" parameterType="Long">
        delete from iip_activity_merchant where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
        	#{id}
        </foreach>
    </delete>
    
</mapper>
