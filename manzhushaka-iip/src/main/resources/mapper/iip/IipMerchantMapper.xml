<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.manzhushaka.iip.mapper.IipMerchantMapper">
    
    <resultMap type="IipMerchant" id="IipMerchantResult">
    	<id     property="merchantId"      column="merchant_id"      />
        <result property="merchantNo"      column="merchant_no"      />
        <result property="merchantName"    column="merchant_name"    />
        <result property="category"        column="category"         />
        <result property="city"            column="city"             />
        <result property="contactName"     column="contact_name"     />
        <result property="contactPhone"    column="contact_phone"    />
        <result property="address"         column="address"          />
        <result property="description"     column="description"      />
        <result property="logo"            column="logo"             />
        <result property="businessHours"   column="business_hours"   />
        <result property="longitude"       column="longitude"        />
        <result property="latitude"        column="latitude"         />
        <result property="businessLicense" column="business_license" />
        <result property="memberId"        column="member_id"        />
        <result property="status"          column="status"           />
        <result property="auditBy"         column="audit_by"         />
        <result property="auditTime"       column="audit_time"       />
        <result property="auditRemark"     column="audit_remark"     />
        <result property="isRecommend"     column="is_recommend"     />
        <result property="createBy"        column="create_by"        />
        <result property="createTime"      column="create_time"      />
        <result property="updateBy"        column="update_by"        />
        <result property="updateTime"      column="update_time"      />
        <result property="remark"          column="remark"           />
    </resultMap>
    
    <sql id="selectIipMerchantVo">
        select merchant_id, merchant_no, merchant_name, category, city, contact_name, contact_phone, address, description, logo, business_hours, longitude, latitude, business_license, member_id, status, audit_by, audit_time, audit_remark, is_recommend, create_by, create_time, update_by, update_time, remark 
		from iip_merchant
    </sql>
    
    <select id="selectIipMerchantList" parameterType="IipMerchant" resultMap="IipMerchantResult">
        <include refid="selectIipMerchantVo"/>
        <where>
			<if test="merchantNo != null and merchantNo != ''">
				AND merchant_no = #{merchantNo}
			</if>
			<if test="merchantName != null and merchantName != ''">
				AND merchant_name like concat('%', #{merchantName}, '%')
			</if>
			<if test="category != null and category != ''">
				AND category = #{category}
			</if>
			<if test="status != null and status != ''">
				AND status = #{status}
			</if>
			<if test="params.beginTime != null and params.beginTime != ''"><!-- 开始时间检索 -->
				and date_format(create_time,'%Y%m%d') &gt;= date_format(#{params.beginTime},'%Y%m%d')
			</if>
			<if test="params.endTime != null and params.endTime != ''"><!-- 结束时间检索 -->
				and date_format(create_time,'%Y%m%d') &lt;= date_format(#{params.endTime},'%Y%m%d')
			</if>
		</where>
		order by merchant_id desc
    </select>
    
    <select id="selectIipMerchantById" parameterType="Long" resultMap="IipMerchantResult">
        <include refid="selectIipMerchantVo"/>
        where merchant_id = #{merchantId}
    </select>
    
    <select id="selectByMemberId" parameterType="Long" resultMap="IipMerchantResult">
        <include refid="selectIipMerchantVo"/>
        where member_id = #{memberId} limit 1
    </select>
    
    <select id="selectByMerchantNo" parameterType="String" resultMap="IipMerchantResult">
        <include refid="selectIipMerchantVo"/>
        where merchant_no = #{merchantNo} limit 1
    </select>

    <!-- C端推荐商户列表：仅正常且推荐（status='0' 且 is_recommend='0'），按更新时间倒序，limit 由调用方做参数保护 -->
    <select id="selectRecommendMerchantList" resultMap="IipMerchantResult">
        <include refid="selectIipMerchantVo"/>
        where status = '0' and is_recommend = '0'
        <if test="category != null and category != ''">
            and category = #{category}
        </if>
        <if test="excludeCategory != null and excludeCategory != ''">
            and category != #{excludeCategory}
        </if>
        order by update_time desc, merchant_id desc
        limit #{limit}
    </select>
    
    <select id="selectMaxMerchantNo" resultType="String">
        select max(merchant_no) from iip_merchant
        where merchant_no like concat(#{prefix}, '%')
    </select>
    
    <!-- 审核条件守护：仅待审核 status='2' 可被审核，重复审核时影响行数为 0，保证幂等 -->
    <update id="updateAuditStatus">
        update iip_merchant
        set status = #{status},
            audit_by = #{auditBy},
            audit_time = sysdate(),
            audit_remark = #{auditRemark},
            update_time = sysdate()
        where merchant_id = #{merchantId} and status = '2'
    </update>
    
    <insert id="insertIipMerchant" parameterType="IipMerchant" useGeneratedKeys="true" keyProperty="merchantId">
        insert into iip_merchant (
			<if test="merchantNo != null and merchantNo != '' ">merchant_no,</if>
			<if test="merchantName != null and merchantName != '' ">merchant_name,</if>
			<if test="category != null and category != '' ">category,</if>
			<if test="city != null and city != '' ">city,</if>
			<if test="contactName != null and contactName != '' ">contact_name,</if>
			<if test="contactPhone != null and contactPhone != '' ">contact_phone,</if>
			<if test="address != null and address != '' ">address,</if>
			<if test="description != null and description != '' ">description,</if>
			<if test="logo != null and logo != '' ">logo,</if>
			<if test="businessHours != null and businessHours != '' ">business_hours,</if>
			<if test="longitude != null">longitude,</if>
			<if test="latitude != null">latitude,</if>
			<if test="businessLicense != null and businessLicense != '' ">business_license,</if>
			<if test="memberId != null">member_id,</if>
			<if test="status != null and status != '' ">status,</if>
			<if test="auditBy != null and auditBy != '' ">audit_by,</if>
			<if test="auditTime != null">audit_time,</if>
			<if test="auditRemark != null and auditRemark != '' ">audit_remark,</if>
			<if test="isRecommend != null and isRecommend != '' ">is_recommend,</if>
			<if test="createBy != null and createBy != ''">create_by,</if>
			<if test="remark != null and remark != ''">remark,</if>
 			create_time
        )values(
			<if test="merchantNo != null and merchantNo != ''">#{merchantNo},</if>
			<if test="merchantName != null and merchantName != ''">#{merchantName},</if>
			<if test="category != null and category != ''">#{category},</if>
			<if test="city != null and city != ''">#{city},</if>
			<if test="contactName != null and contactName != ''">#{contactName},</if>
			<if test="contactPhone != null and contactPhone != ''">#{contactPhone},</if>
			<if test="address != null and address != ''">#{address},</if>
			<if test="description != null and description != ''">#{description},</if>
			<if test="logo != null and logo != ''">#{logo},</if>
			<if test="businessHours != null and businessHours != ''">#{businessHours},</if>
			<if test="longitude != null">#{longitude},</if>
			<if test="latitude != null">#{latitude},</if>
			<if test="businessLicense != null and businessLicense != ''">#{businessLicense},</if>
			<if test="memberId != null">#{memberId},</if>
			<if test="status != null and status != ''">#{status},</if>
			<if test="auditBy != null and auditBy != ''">#{auditBy},</if>
			<if test="auditTime != null">#{auditTime},</if>
			<if test="auditRemark != null and auditRemark != ''">#{auditRemark},</if>
			<if test="isRecommend != null and isRecommend != ''">#{isRecommend},</if>
			<if test="createBy != null and createBy != ''">#{createBy},</if>
			<if test="remark != null and remark != ''">#{remark},</if>
 			sysdate()
		)
    </insert>
	 
    <update id="updateIipMerchant" parameterType="IipMerchant">
        update iip_merchant 
        <set>
            <if test="merchantNo != null and merchantNo != ''">merchant_no = #{merchantNo},</if>
            <if test="merchantName != null and merchantName != ''">merchant_name = #{merchantName},</if>
            <if test="category != null">category = #{category},</if>
            <if test="city != null">city = #{city},</if>
            <if test="contactName != null">contact_name = #{contactName},</if>
            <if test="contactPhone != null">contact_phone = #{contactPhone},</if>
            <if test="address != null">address = #{address},</if>
            <if test="description != null">description = #{description},</if>
            <if test="logo != null">logo = #{logo},</if>
            <if test="businessHours != null">business_hours = #{businessHours},</if>
            <if test="longitude != null">longitude = #{longitude},</if>
            <if test="latitude != null">latitude = #{latitude},</if>
            <if test="businessLicense != null">business_license = #{businessLicense},</if>
            <if test="memberId != null">member_id = #{memberId},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="auditBy != null">audit_by = #{auditBy},</if>
            <if test="auditTime != null">audit_time = #{auditTime},</if>
            <if test="auditRemark != null">audit_remark = #{auditRemark},</if>
            <if test="isRecommend != null and isRecommend != ''">is_recommend = #{isRecommend},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
 			update_time = sysdate()
        </set>
        where merchant_id = #{merchantId}
    </update>
	
    <delete id="deleteIipMerchantById" parameterType="Long">
        delete from iip_merchant where merchant_id = #{merchantId}
    </delete>
    
    <delete id="deleteIipMerchantByIds" parameterType="Long">
        delete from iip_merchant where merchant_id in 
        <foreach item="merchantId" collection="array" open="(" separator="," close=")">
        	#{merchantId}
        </foreach>
    </delete>
    
</mapper>
