{
  "name": "ui-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:sidebar": "node --experimental-strip-types scripts/sidebar-menu.test.mjs",
    "check:mock-menus": "node --loader ./scripts/alias-loader.mjs --experimental-strip-types scripts/mock-menu-consistency.test.mjs",
    "test:unit": "node --loader ./scripts/alias-loader.mjs --experimental-strip-types --test tests/*.test.ts",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@arco-design/web-vue": "^2.57.0",
    "axios": "^1.9.0",
    "pinia": "^3.0.2",
    "vue": "^3.5.16",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "typescript": "^5.8.3",
    "vite": "^5.4.19",
    "vue-tsc": "^2.2.12"
  }
}
