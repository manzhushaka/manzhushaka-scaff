<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ================================================================= -->
    <!-- 项目坐标：Maven 唯一标识一个项目的三维坐标                        -->
    <!-- groupId : 项目组 ID，通常是公司/组织域名倒写                     -->
    <!-- artifactId : 项目唯一 artifact 名                                 -->
    <!-- version : 项目版本号                                              -->
    <!-- ================================================================= -->
    <groupId>com.manzhushaka</groupId>
    <artifactId>manzhushaka-ry</artifactId>
    <version>3.9.2</version>

    <name>manzhushaka-ry</name>                 <!-- 项目显示名称 -->
    <url>http://www.manzhushaka.vip</url>       <!-- 项目官网地址 -->
    <description>若依管理系统</description>      <!-- 项目简短描述 -->

    <!-- ================================================================= -->
    <!-- 属性定义：集中管理所有版本号，方便统一升级                        -->
    <!-- 子模块通过 ${property.name} 引用这些版本号                        -->
    <!-- ================================================================= -->
    <properties>
        <!-- 内部模块统一版本 -->
        <manzhushaka.version>3.9.2</manzhushaka.version>

        <!-- 编码与 Java 版本 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <java.version>17</java.version>

        <!-- 第三方依赖版本 -->
        <spring-boot.version>4.0.6</spring-boot.version>
        <mybatis-spring-boot.version>4.0.1</mybatis-spring-boot.version>
        <druid.version>1.2.28</druid.version>
        <yauaa.version>8.1.1</yauaa.version>
        <hutool.version>5.8.46</hutool.version>
        <pagehelper.boot.version>4.1.0</pagehelper.boot.version>
        <fastjson.version>2.0.62</fastjson.version>
        <oshi.version>7.3.0</oshi.version>
        <commons.io.version>2.22.0</commons.io.version>
        <poi.version>4.1.2</poi.version>
        <velocity.version>2.3</velocity.version>
        <jwt.version>0.9.1</jwt.version>
        <jaxb-api.version>2.3.1</jaxb-api.version>
        <springdoc.version>3.0.3</springdoc.version>
        <archunit.version>1.4.0</archunit.version>

    </properties>

    <!-- ================================================================= -->
    <!-- 依赖版本管理 (dependencyManagement)                                 -->
    <!-- 功能：统一定义所有依赖的版本号，子模块引用时无需再写 version      -->
    <!-- 注意：此标签仅声明版本，子模块仍需显式声明 groupId + artifactId    -->
    <!-- ================================================================= -->
    <dependencyManagement>
        <dependencies>

            <!-- ========================================================= -->
            <!-- Spring Boot BOM                                            -->
            <!-- 引入 spring-boot-dependencies 的 BOM（Bill of Materials）， -->
            <!-- 将 Spring Boot 全家桶的版本统一交由 spring-boot-dependencies -->
            <!-- 管理。子模块引入 Spring 依赖时无需指定版本。               -->
            <!-- 通过 type=pom + scope=import 实现                          -->
            <!-- ========================================================= -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ========================================================= -->
            <!-- Druid 数据库连接池                                          -->
            <!-- 阿里巴巴出品的高性能 JDBC 连接池，提供监控、扩展、防 SQL   -->
            <!-- 注入等功能，替代 HikariCP 或 Tomcat JDBC Pool。            -->
            <!-- ========================================================= -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>druid-spring-boot-4-starter</artifactId>
                <version>${druid.version}</version>
            </dependency>

            <!-- ========================================================= -->
            <!-- Yauaa User-Agent 解析库                                    -->
            <!-- 解析 HTTP 请求头 User-Agent，识别客户端操作系统、浏览器、  -->
            <!-- 设备类型等，用于操作日志记录客户端信息。                   -->
            <!-- ========================================================= -->
            <dependency>
                <groupId>nl.basjes.parse.useragent</groupId>
                <artifactId>yauaa</artifactId>
                <version>${yauaa.version}</version>
            </dependency>

            <!-- ========================================================= -->
            <!-- PageHelper 分页插件                                        -->
            <!-- MyBatis 通用分页插件，自动拦截 SQL 拼接 COUNT 和 LIMIT，  -->
            <!-- 支持多种数据库方言。                                       -->
            <!-- ========================================================= -->
            <dependency>
                <groupId>com.github.pagehelper</groupId>
                <artifactId>pagehelper-spring-boot-starter</artifactId>
                <version>${pagehelper.boot.version}</version>
            </dependency>

            <!-- ========================================================= -->
            <!-- MyBatis Spring Boot Starter                                -->
            <!-- MyBatis 持久层框架与 Spring Boot 的集成启动器。            -->
            <!-- 自动配置 SqlSessionFactory、MapperScanner、事务等。        -->
            <!-- ========================================================= -->
            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>${mybatis-spring-boot.version}</version>
            </dependency>

            <!-- ========================================================= -->
            <!-- JAXB API                                                   -->
            <!-- Java Architecture for XML Binding。Java 17 已从 JDK 中移除 -->
            <!-- JAXB，需单独引入。用于 XML 与 Java 对象的互相转换。       -->
            <!-- ========================================================= -->
            <dependency>
                <groupId>javax.xml.bind</groupId>
                <artifactId>jaxb-api</artifactId>
                <version>${jaxb-api.version}</version>
            </dependency>

            <!-- ========================================================= -->
            <!-- OSHI 系统信息库                                            -->
            <!-- 跨平台（Windows/Linux/macOS）获取系统信息：CPU 使用率、   -->
            <!-- 内存、磁盘、网络、进程等。用于系统监控页面。             -->
            <!-- ========================================================= -->
            <dependency>
                <groupId>com.github.oshi</groupId>
                <artifactId>oshi-core</artifactId>
                <version>${oshi.version}</version>
            </dependency>

            <!-- ========================================================= -->
            <!-- SpringDoc OpenAPI                                          -->
            <!-- 自动生成 RESTful API 接口文档，集成 Swagger UI 界面。     -->
            <!-- 支持 Spring Boot 3.x / Spring 6.x（基于 Jakarta）。        -->
            <!-- ========================================================= -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- ========================================================= -->
            <!-- Commons IO                                                 -->
            <!-- Apache Commons IO 工具库，提供文件读写、复制、过滤等       -->
            <!-- 常用 IO 操作的便捷封装。                                   -->
            <!-- ========================================================= -->
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>${commons.io.version}</version>
            </dependency>

            <!-- ========================================================= -->
            <!-- Apache POI                                                 -->
            <!-- 操作 Office 文档的 Java 库。此处引入 poi-ooxml 用于        -->
            <!-- 读写 Excel (.xlsx) 文件，实现数据导入导出。               -->
            <!-- ========================================================= -->
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi-ooxml</artifactId>
                <version>${poi.version}</version>
            </dependency>

            <!-- ========================================================= -->
            <!-- Velocity 模板引擎                                          -->
            <!-- Apache 的模板引擎，用于代码生成器：根据模板 + 数据模型    -->
            <!-- 生成 Java 代码、XML、SQL 等文件。                         -->
            <!-- ========================================================= -->
            <dependency>
                <groupId>org.apache.velocity</groupId>
                <artifactId>velocity-engine-core</artifactId>
                <version>${velocity.version}</version>
            </dependency>

            <!-- ========================================================= -->
            <!-- FastJSON2                                                  -->
            <!-- 阿里巴巴高性能 JSON 序列化/反序列化库，支持 JSON、JSONB、 -->
            <!-- 与 Spring 等框架集成。FastJSON2 是 FastJSON 的重构版本。  -->
            <!-- ========================================================= -->
            <dependency>
                <groupId>com.alibaba.fastjson2</groupId>
                <artifactId>fastjson2</artifactId>
                <version>${fastjson.version}</version>
            </dependency>

            <!-- ========================================================= -->
            <!-- JJWT                                                       -->
            <!-- Java JWT（JSON Web Token）库，用于生成和验证登录 Token，  -->
            <!-- 实现无状态认证。                                          -->
            <!-- ========================================================= -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt</artifactId>
                <version>${jwt.version}</version>
            </dependency>

            <!-- ========================================================= -->
            <!-- Hutool 验证码                                             -->
            <!-- 生成图片验证码工具，支持静态字符验证码和多种干扰样式。     -->
            <!-- ========================================================= -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-captcha</artifactId>
                <version>${hutool.version}</version>
            </dependency>

            <!-- ========================================================= -->
            <!-- 项目内部模块依赖声明                                       -->
            <!-- ========================================================= -->

            <!-- 定时任务模块：基于 Quartz 的任务调度 -->
            <dependency>
                <groupId>com.manzhushaka</groupId>
                <artifactId>manzhushaka-ry-quartz</artifactId>
                <version>${manzhushaka.version}</version>
            </dependency>

            <!-- 核心框架模块：封装安全认证、权限控制、AOP 切面、全局配置等 -->
            <dependency>
                <groupId>com.manzhushaka</groupId>
                <artifactId>manzhushaka-ry-framework</artifactId>
                <version>${manzhushaka.version}</version>
            </dependency>

            <!-- 系统管理模块：用户管理、角色管理、菜单管理、部门管理等基础功能 -->
            <dependency>
                <groupId>com.manzhushaka</groupId>
                <artifactId>manzhushaka-ry-system</artifactId>
                <version>${manzhushaka.version}</version>
            </dependency>

            <!-- 通用工具模块：常量定义、通用工具类、自定义注解、异常定义等 -->
            <dependency>
                <groupId>com.manzhushaka</groupId>
                <artifactId>manzhushaka-ry-common</artifactId>
                <version>${manzhushaka.version}</version>
            </dependency>

            <!-- ========================================================= -->
            <!-- Spring Boot Test                                           -->
            <!-- Spring Boot 测试框架，集成 JUnit、Mockito、AssertJ 等     -->
            <!-- 子模块通过 scope=test 引入，无需重复指定版本。            -->
            <!-- ========================================================= -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-test</artifactId>
                <version>${spring-boot.version}</version>
                <scope>test</scope>
            </dependency>
    
                <!-- ========================================================= -->
                <!-- ArchUnit 架构测试                                          -->
                <!-- Java 架构测试框架，用于验证代码架构约定（如分层依赖规则） -->
                <!-- ========================================================= -->
                <dependency>
                    <groupId>com.tngtech.archunit</groupId>
                    <artifactId>archunit-junit5</artifactId>
                    <version>${archunit.version}</version>
                    <scope>test</scope>
                </dependency>
    
            </dependencies>
        </dependencyManagement>

    <!-- ================================================================= -->
    <!-- 模块定义 (modules)                                                 -->
    <!-- 声明此聚合工程包含的子模块，Maven 按声明顺序构建各模块。          -->
    <!-- 构建时执行 mvn install 会自动包含所有模块。                       -->
    <!-- ================================================================= -->
    <modules>
        <module>manzhushaka-ry-admin</module>      <!-- Web 启动层：Controller、全局异常处理、配置入口 -->
        <module>manzhushaka-ry-framework</module>  <!-- 核心框架层：安全、AOP、配置、拦截器 -->
        <module>manzhushaka-ry-system</module>     <!-- 系统业务层：用户、角色、菜单、部门等业务实现 -->
        <module>manzhushaka-ry-quartz</module>     <!-- 定时任务层：Quartz 任务调度管理 -->
        <module>manzhushaka-ry-common</module>     <!-- 通用工具层：常量、工具类、通用注解 -->
    </modules>

    <!-- ================================================================= -->
    <!-- 打包类型：pom 表示这是一个聚合 POM（父工程），不产出 jar/war。   -->
    <!-- 子模块的 pom.xml 会继承此 POM 的配置。                           -->
    <!-- ================================================================= -->
    <packaging>pom</packaging>

    <!-- ================================================================= -->
    <!-- 构建配置 (build)                                                  -->
    <!-- 配置编译、打包等构建环节使用的插件。子模块会继承这些配置。       -->
    <!-- ================================================================= -->
    <build>
        <plugins>

            <!-- 编译插件：设置 Java 版本、编码和编译参数 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <parameters>true</parameters>                        <!-- 编译时保留方法参数名（反射用） -->
                    <source>${java.version}</source>                     <!-- 源码 Java 版本 -->
                    <target>${java.version}</target>                     <!-- 目标字节码版本 -->
                    <encoding>${project.build.sourceEncoding}</encoding> <!-- 源码文件编码 -->
                </configuration>
            </plugin>

            <!-- Spring Boot Maven 打包插件：将应用打包为可执行 fat JAR -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
            </plugin>

            <!-- Surefire 测试插件：配置 JUnit 5 测试执行 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>

        </plugins>
    </build>

    <!-- ================================================================= -->
    <!-- 依赖仓库 (repositories)                                            -->
    <!-- Maven 从这里下载第三方依赖 JAR 包。按声明顺序依次查找，           -->
    <!-- 第一个仓库中找不到的依赖会尝试从第二个仓库下载。                 -->
    <!-- 所有仓库的 snapshots 均被禁用（enabled=false），确保构建可复现。 -->
    <!-- ================================================================= -->
    <repositories>
        <!-- Maven Central：全球最大的 Java 依赖仓库，由 Sonatype 维护。  -->
        <!-- 包含几乎所有主流开源 Java 库。                               -->
        <repository>
            <id>maven-central</id>
            <name>Maven Central</name>
            <url>https://repo1.maven.org/maven2/</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>

        <!-- 阿里云 Maven 镜像：Maven Central 的国内镜像，下载速度更快。 -->
        <!-- 当官方仓库不可用或速度慢时作为备选源。                       -->
        <repository>
            <id>aliyun</id>
            <name>Aliyun Maven Mirror</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <!-- ================================================================= -->
    <!-- 插件仓库 (pluginRepositories)                                      -->
    <!-- Maven 从这里下载构建插件（如 compiler-plugin、jar-plugin 等）。   -->
    <!-- 与 dependencies 的仓库分开配置，互不影响。                        -->
    <!-- ================================================================= -->
    <pluginRepositories>
        <!-- Maven Central 插件仓库 -->
        <pluginRepository>
            <id>maven-central-plugins</id>
            <name>Maven Central</name>
            <url>https://repo1.maven.org/maven2/</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>

        <!-- 阿里云镜像插件仓库 -->
        <pluginRepository>
            <id>aliyun-plugins</id>
            <name>Aliyun Maven Mirror</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>

</project>
