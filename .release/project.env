PROJECT_NAME=manzhushaka-scaff
PROJECT_TYPE=java-maven
RUNTIME=java
RUNTIME_VERSION=17
HEALTHCHECK_URL=http://127.0.0.1:8080/actuator/health
PUBLIC_HEALTH_URL=https://manzhushaka.cn/gateway/manzhushaka-scaff/health
JAVA_ARTIFACT=manzhushaka-admin/target/manzhushaka-admin.jar
JAVA_LAYERED_RELEASE=true
NODE_ENTRY=dist/server.js
NODE_EXTRA_PATHS=''
MAX_RELEASE_ARCHIVE_MIB=150
RELEASE_REQUIRED_FILES='deploy/manzhushaka-scaff.locations.conf'
REMOTE_RUNTIME_PATH=/usr/bin/java
REMOTE_REQUIRED_PATHS=''
REMOTE_REQUIRED_UNITS=personal-project@manzhushaka-scaff.service
REMOTE_NGINX_PATHS=/home/middleware/nginx/conf/conf.d/manzhushaka-scaff.locations.conf
REMOTE_MIN_FREE_MIB=512
REQUIRE_APP_ENV=true
STATIC_DIR=dist
