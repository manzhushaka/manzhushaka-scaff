{
  "name": "ui-miniapp",
  "version": "1.0.0",
  "private": true,
  "description": "发票积分平台小程序端（uni-app Vue3 + Vite + pinia，编译目标 mp-weixin / mp-alipay / h5）",
  "scripts": {
    "dev:h5": "uni --host",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:mp-alipay": "uni -p mp-alipay",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:mp-alipay": "uni build -p mp-alipay"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-mp-alipay": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5020120260710001",
    "pinia": "^2.1.7",
    "qrcode-generator": "^2.0.4",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5020120260710001",
    "vite": "5.2.8"
  }
}
