<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.manzhushaka.quartz.mapper.SysJobLogDetailMapper">

    <resultMap type="SysJobLogDetail" id="SysJobLogDetailResult">
        <id     property="detailId"    column="detail_id"   />
        <result property="jobLogId"    column="job_log_id"  />
        <result property="logLevel"    column="log_level"   />
        <result property="logContent"  column="log_content" />
        <result property="sortNo"      column="sort_no"     />
        <result property="createTime"  column="create_time" />
    </resultMap>

    <insert id="insertJobLogDetails">
        insert into sys_job_log_detail(job_log_id, log_level, log_content, sort_no, create_time)
        values
        <foreach collection="list" item="detail" separator=",">
            (#{detail.jobLogId}, #{detail.logLevel}, #{detail.logContent}, #{detail.sortNo}, sysdate())
        </foreach>
    </insert>

    <select id="selectJobLogDetailListByJobLogId" parameterType="Long" resultMap="SysJobLogDetailResult">
        select detail_id, job_log_id, log_level, log_content, sort_no, create_time
        from sys_job_log_detail
        where job_log_id = #{jobLogId}
        order by sort_no asc, detail_id asc
    </select>

    <delete id="deleteJobLogDetailByJobLogIds" parameterType="Long">
        delete from sys_job_log_detail where job_log_id in
        <foreach collection="array" item="jobLogId" open="(" separator="," close=")">
            #{jobLogId}
        </foreach>
    </delete>

    <delete id="deleteJobLogDetailByJobLogId" parameterType="Long">
        delete from sys_job_log_detail where job_log_id = #{jobLogId}
    </delete>

    <update id="cleanJobLogDetail">
        truncate table sys_job_log_detail
    </update>

</mapper>
