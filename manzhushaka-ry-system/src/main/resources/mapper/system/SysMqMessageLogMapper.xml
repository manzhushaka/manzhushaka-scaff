<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.manzhushaka.system.mapper.SysMqMessageLogMapper">

    <resultMap type="SysMqMessageLog" id="SysMqMessageLogResult">
        <id     property="messageLogId"      column="message_log_id"      />
        <result property="messageType"       column="message_type"        />
        <result property="streamKey"         column="stream_key"          />
        <result property="messageId"         column="message_id"          />
        <result property="consumerGroup"     column="consumer_group"      />
        <result property="businessKey"       column="business_key"        />
        <result property="payload"           column="payload"             />
        <result property="status"            column="status"              />
        <result property="retryTimes"        column="retry_times"         />
        <result property="maxRetryTimes"     column="max_retry_times"     />
        <result property="firstConsumeTime"  column="first_consume_time"  />
        <result property="lastConsumeTime"   column="last_consume_time"   />
        <result property="successTime"       column="success_time"        />
        <result property="deadLetterTime"    column="dead_letter_time"    />
        <result property="lastErrorMsg"      column="last_error_msg"      />
        <result property="createBy"          column="create_by"           />
        <result property="createTime"        column="create_time"         />
        <result property="updateBy"          column="update_by"           />
        <result property="updateTime"        column="update_time"         />
    </resultMap>

    <sql id="selectMessageLogVo">
        select message_log_id, message_type, stream_key, message_id, consumer_group, business_key,
               payload, status, retry_times, max_retry_times, first_consume_time, last_consume_time,
               success_time, dead_letter_time, last_error_msg, create_by, create_time, update_by, update_time
        from sys_mq_message_log
    </sql>

    <insert id="insertMessageLog" parameterType="SysMqMessageLog" useGeneratedKeys="true" keyProperty="messageLogId">
        insert into sys_mq_message_log(message_type, stream_key, message_id, consumer_group, business_key, payload,
                                       status, retry_times, max_retry_times, first_consume_time, last_consume_time,
                                       success_time, dead_letter_time, last_error_msg, create_time, update_time)
        values (#{messageType}, #{streamKey}, #{messageId}, #{consumerGroup}, #{businessKey}, #{payload},
                #{status}, #{retryTimes}, #{maxRetryTimes}, #{firstConsumeTime}, #{lastConsumeTime},
                #{successTime}, #{deadLetterTime}, #{lastErrorMsg}, sysdate(), sysdate())
    </insert>

    <update id="updateMessageLog" parameterType="SysMqMessageLog">
        update sys_mq_message_log
        <set>
            <if test="messageType != null and messageType != ''">message_type = #{messageType},</if>
            <if test="streamKey != null and streamKey != ''">stream_key = #{streamKey},</if>
            <if test="messageId != null and messageId != ''">message_id = #{messageId},</if>
            <if test="consumerGroup != null and consumerGroup != ''">consumer_group = #{consumerGroup},</if>
            <if test="businessKey != null and businessKey != ''">business_key = #{businessKey},</if>
            <if test="payload != null and payload != ''">payload = #{payload},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="retryTimes != null">retry_times = #{retryTimes},</if>
            <if test="maxRetryTimes != null">max_retry_times = #{maxRetryTimes},</if>
            <if test="firstConsumeTime != null">first_consume_time = #{firstConsumeTime},</if>
            <if test="lastConsumeTime != null">last_consume_time = #{lastConsumeTime},</if>
            <if test="successTime != null">success_time = #{successTime},</if>
            <if test="deadLetterTime != null">dead_letter_time = #{deadLetterTime},</if>
            <if test="lastErrorMsg != null and lastErrorMsg != ''">last_error_msg = #{lastErrorMsg},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where message_log_id = #{messageLogId}
    </update>

    <select id="selectMessageLogById" parameterType="Long" resultMap="SysMqMessageLogResult">
        <include refid="selectMessageLogVo"/>
        where message_log_id = #{messageLogId}
    </select>

    <select id="selectMessageLogByStreamAndMessageId" resultMap="SysMqMessageLogResult">
        <include refid="selectMessageLogVo"/>
        where stream_key = #{streamKey} and message_id = #{messageId}
    </select>

    <select id="selectMessageLogList" parameterType="SysMqMessageLog" resultMap="SysMqMessageLogResult">
        <include refid="selectMessageLogVo"/>
        <where>
            <if test="messageType != null and messageType != ''">
                AND message_type = #{messageType}
            </if>
            <if test="streamKey != null and streamKey != ''">
                AND stream_key like concat('%', #{streamKey}, '%')
            </if>
            <if test="businessKey != null and businessKey != ''">
                AND business_key like concat('%', #{businessKey}, '%')
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="params.beginTime != null and params.beginTime != ''">
                AND create_time >= #{params.beginTime}
            </if>
            <if test="params.endTime != null and params.endTime != ''">
                AND create_time <= #{params.endTime}
            </if>
        </where>
        order by create_time desc, message_log_id desc
    </select>

    <delete id="deleteMessageLogByIds" parameterType="Long">
        delete from sys_mq_message_log where message_log_id in
        <foreach collection="array" item="messageLogId" open="(" separator="," close=")">
            #{messageLogId}
        </foreach>
    </delete>

    <update id="cleanMessageLog">
        truncate table sys_mq_message_log
    </update>

</mapper>